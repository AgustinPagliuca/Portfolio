---
import { projects } from '../../data/portfolioData';

const categories = ['todos', ...new Set(projects.map((p) => p.category.toLowerCase()))];
---

<section id="proyectos" class="col">
  <p class="stitle rv">proyectos</p>
  <h2 class="shead rv">Trabajo real, en producción.</h2>
  <p class="ssub rv">Cada proyecto resuelve un problema concreto — filtrá por capa del stack.</p>

  <div class="filters rv" role="group" aria-label="Filtrar proyectos">
    {categories.map((cat, i) => (
      <button class:list={['chip', { on: i === 0 }]} data-f={cat === 'todos' ? 'all' : cat}>{cat}</button>
    ))}
  </div>

  <div class="pgrid" id="pgrid">
    {projects.map((project) => (
      <article class="pcard rv" data-cat={project.category.toLowerCase()}>
        <div class="thumb">
          <img src={project.image} alt={`Captura del proyecto ${project.title}`} loading="lazy" />
          <span class="tagf">{project.category}</span>
        </div>
        <div class="pbody">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="ptech">
            {project.tech.map((t) => <span class="tt">{t}</span>)}
          </div>
          <div class="plinks">
            {project.link && project.link !== project.github && (
              <a href={project.link} target="_blank" rel="noopener noreferrer">Ver en vivo ↗</a>
            )}
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer">Ver código ↗</a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="pcount" id="pcount">{projects.length} de {projects.length} proyectos</p>
</section>

<script>
  const chips = document.querySelectorAll<HTMLElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.pcard');
  const pcount = document.getElementById('pcount')!;
  chips.forEach((ch) =>
    ch.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('on'));
      ch.classList.add('on');
      const f = ch.dataset.f;
      let n = 0;
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.cat === f;
        c.classList.toggle('hid', !show);
        if (show) n++;
      });
      pcount.textContent = `${n} de ${cards.length} proyectos${f === 'all' ? '' : ' · ' + f}`;
    })
  );
</script>
