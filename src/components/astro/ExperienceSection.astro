---
import { experience } from '../../data/portfolioData';
---

<section id="experiencia" class="col">
  <p class="stitle rv">experiencia</p>
  <h2 class="shead rv">Mi recorrido.</h2>
  <div class="exp rv">
    {experience.map((exp) => (
      <div class="erow">
        <span class="eyr">{exp.period}</span>
        <div>
          <h3>{exp.title} <span>· {exp.company}</span></h3>
          <p>{exp.description}</p>
          <div class="estack">
            {exp.stack.map((s) => <span class="tt">{s}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
