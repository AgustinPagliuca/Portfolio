---
import { personalInfo } from '../../data/portfolioData';
---

<section id="contacto" class="col contact">
  <div class="cbox rv">
    <p class="stitle" style="display:flex;justify-content:center">contacto</p>
    <h2>¿Tenés un proyecto en mente?</h2>
    <p>Escribime y lo hablamos — respondo rápido.</p>
    <div class="cbtns">
      <a class="b-acc" href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a>
      <button class="b-line" id="copy-email" data-email={personalInfo.email}>Copiar email</button>
    </div>
    <div class="socials">
      <a class="soc" href={personalInfo.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      </a>
      <a class="soc" href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      <a class="soc" href={personalInfo.cvUrl} target="_blank" rel="noopener noreferrer" aria-label="Descargar CV">
        <svg viewBox="0 0 24 24"><path d="M12 16 6 10h4V3h4v7h4l-6 6zm-7 4v-2h14v2H5z"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  const copy = document.getElementById('copy-email')!;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.email!);
      copy.textContent = '✓ Copiado';
      setTimeout(() => (copy.textContent = 'Copiar email'), 1800);
    } catch {
      copy.textContent = copy.dataset.email!;
    }
  });
</script>
