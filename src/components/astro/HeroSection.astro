---
import { personalInfo, heroStats } from '../../data/portfolioData';
---

<section class="hero col" id="top">
  <p class="kicker">hola, soy</p>
  <h1>{personalInfo.name}<br />{personalInfo.lastName}<span>.</span></h1>
  <p class="role">{personalInfo.title} <em>&lt;{personalInfo.subtitle.replaceAll(' · ', ' · ')} /&gt;</em></p>
  <p class="lead">
    Construyo productos web completos: interfaces con <strong>React</strong> y <strong>Astro</strong>,
    backend con <strong>Java/Spring</strong> y <strong>C#/.NET Core</strong>, datos con <strong>SQL Server</strong>.
  </p>
  <div class="hero-cta">
    <a class="b-acc" href="#proyectos">Ver proyectos ↓</a>
    <a class="b-line" href={personalInfo.cvUrl} target="_blank" rel="noopener noreferrer">Descargar CV</a>
  </div>
  <div class="hero-meta">
    {heroStats.map((s) => (
      <span class="hm">
        {s.live && <span class="dotl"></span>}
        <b>{s.value}</b> {s.label}
      </span>
    ))}
  </div>
</section>
